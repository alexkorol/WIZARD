{
  "schema": "owner-rules.rename-map.v1",
  "date": "2026-11-07",
  "rule": "OWNER-RULES.md rules 5-8 and 12: plain functional names. Display strings change; ids, keys, unlock flags, stat ids, seat ids and saved-data values stay.",
  "apply": "node owner-rules/apply-rename-map.mjs --root <repo> [files...]. Exact-value entries replace a whole string value; phrase entries replace word-bounded text, longest first. In code files only string literals and comments change.",
  "flaggedNotRenamed": [
    {
      "term": "Arcane Lattice node and tier labels (Source, Adversarial, Natural, Destructive, Sustaining, Creative, Air, Water, Earth, Body, Spirit, Mind, Outer, Inner, Manifestation; Plane, Vessel, Tesseract; Schism; Paradigm Shift)",
      "why": "Saved-weave values, and the lattice is protected by WIZARD AGENTS.md rules 5-6; needs a display layer and its own pass. Proposed: Air/Water/Earth -> Lightning/Cold/Chaos (rule 5); Plane/Vessel/Tesseract -> Tier 1/2/3; Schism -> Swap; Paradigm Shift -> Swap rows."
    },
    {
      "term": "Creature names (Lindwurm, Kraken, Hydra, Bone/Beetle/Lava Golem, Night/Glutton/Chained/Horned Demon, Flying Terror)",
      "why": "Mythic or fantasy names in CreatureCatalog; a creature pass should name them by what they are (rule 8, e.g. 'Great serpent')."
    },
    {
      "term": "Currency 'Searing Ash'",
      "why": "Crafting currency named by flourish; propose 'Add Property' style naming in a currency pass."
    },
    {
      "term": "Era items: Hammered Iron, Riveted Mail, Crest, Macuahuitl, Gorytos",
      "why": "Rule 12 questions (iron, mail, crested helmets, Mesoamerican and Scythian forms), not naming; awaiting owner ruling."
    },
    {
      "term": "VesselForge awakening (generated names and flavour text on awakened items, rpg_inventory README)",
      "why": "A design rule, not a label; protected by WIZARD AGENTS.md rule 6. Conflicts with rules 6 and 10; owner ruling needed."
    },
    {
      "term": "rpg_inventory faction names (riverspill, dustwind ...)",
      "why": "Internal lane keys today; any player-facing use needs plain names in a separate pass."
    },
    {
      "term": "Playtest player names (House Arwa, House Olwa, Amazuk, Taru, Ishra)",
      "why": "Player-chosen names in fixtures, kept as proper names (terms.json nameProper)."
    }
  ],

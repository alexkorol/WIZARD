{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alexkorol.github.io/WIZARD/schema/wizard.annotation.v1.schema.json",
  "title": "WIZARD annotation",
  "type": "object",
  "required": ["schemaVersion", "id", "type", "status", "title", "body", "createdAt", "updatedAt", "anchor"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["idea", "placement", "bug", "balance", "visual", "question", "preserve"]
    },
    "status": { "type": "string", "enum": ["open", "resolved", "deleted"] },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "anchor": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["semantic", "world", "screen", "region"] },
        "semantic": {
          "type": "object",
          "properties": {
            "targetType": { "type": "string" },
            "targetId": { "type": "string" }
          }
        },
        "world": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": ["number", "null"] }
          }
        },
        "screen": {
          "type": "object",
          "properties": {
            "nx": { "type": "number" },
            "ny": { "type": "number" }
          }
        },
        "region": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "w": { "type": "number" },
            "h": { "type": "number" }
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["small_passive", "notable", "mastery", "keystone", "gateway", "socket", "pattern", "visual_feature"]
        },
        "name": { "type": "string" },
        "mechanicalText": { "type": "string" }
      }
    }
  }
}
